{
  "name": "SoundDrop",
  "short_name": "SoundDrop",
  "description": "Share short messages and contact cards with nearby devices using only sound. No internet, Wi-Fi or Bluetooth.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#2f5bea",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Send", "url": "./#send", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Receive", "url": "./#receive", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
